# dependencies
/node_modules

# next.js
/.next/
/out/
next-env.d.ts.bak
*.tsbuildinfo

# 環境変数（秘密情報はコミットしない）
.env
.env.local
.env.*.local

# 第2段階で外部から取得した生データの置き場（コミットしない）
/data-cache/

# OS / editor
.DS_Store
Thumbs.db

# 第3段階で追加 ------------------------------------------------
# 外部から入手した生データ（第三者のコンテンツを保存・再配布しない）
/external/*
!/external/README.md

# 正規化済みデータ（生成物）
/normalized/*
!/normalized/README.md

# 取り込みの開発用キャッシュ
/.cache/

# 第5.2段階で追加 ----------------------------------------------
# テストカバレッジ（生成物）
/coverage/

# ログ
*.log
npm-debug.log*

# 2台運用（自宅PC・会社PC）で追加 ------------------------------
# 秘密情報は、ファイル名が少し違っても絶対に取り込まれないようにする。
# ★このリポジトリは public（全世界に公開）です。★
#   一度pushすると、あとから消しても取得済みの人には残ります。
#
# .env の仲間（.env.local / .env.production など）はすべて除外。
# ただし .env.example だけは例外（値が空の雛形なので公開してよい）。
.env.*
!.env.example

# 鍵・証明書・認証情報のファイル
*.key
*.pem
*.p12
*.pfx
*.keystore
*.jks
credentials.json
credentials.*.json
secrets.json
service-account*.json
