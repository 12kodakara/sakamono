{
  "name": "sakamono",
  "version": "0.1.0",
  "private": true,
  "description": "サカモノ - 海外サッカーグッズを日本到着推定額で比較するサイト",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "npx --yes serve out -l 3001",
