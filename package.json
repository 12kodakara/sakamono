    "data:domestic:compare": "node scripts/domestic-compare.mjs"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28",
    "typescript": "^5",
    "vitest": "^3"
  }
}
