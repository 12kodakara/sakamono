# ============================================================
# サカモノ 環境変数サンプル
# ------------------------------------------------------------
# 使い方:
#   1. このファイルを .env.local という名前でコピーする
#   2. 値を自分のものに書き換える
#   3. .env.local は .gitignore 済みなのでコミットされない
#
# 重要: APIキーなどの秘密情報は、必ずこの仕組みで渡すこと。
#       ソースコードへ直接書き込まない。
#
# 2台のPC（自宅・会社）で使う場合:
#   .env.local は GitHub に入りません（入れてはいけません）。
#   もう1台で必要になったら、このファイルをコピーして手で入力します。
#   ★キーそのものを GitHub・チャット・メールで渡さないこと。★
#   ★このリポジトリは public です。一度pushすると取り消せません。★
#   会社PCでは API 取得コマンドを使わないため、.env.local は不要です。
#   （置かないのがいちばん安全です）
# ============================================================

# --- データソースの切り替え ---------------------------------
# fixture       : リポジトリ内の開発用サンプルデータを使う（既定値）
# liverpool     : 取り込み済みの Liverpool データを使う（第3段階・ローカル検証専用）
# fixture-yahoo : 海外＝開発用データ、国内＝Yahoo!取得データ（第4段階・ローカル検証専用）
# api           : 外部APIから取得する（未実装）
#
# liverpool を使うには、先に取り込みコマンドを実行してください:
#   npm run data:liverpool:fetch -- --sample
#
# fixture-yahoo を使うには:
#   npm run data:yahoo:search -- --product=product-lfc-2526-home-replica --sample
#
# ★liverpool のデータのまま公開しないでください。★
#   画面の上部に「公開しないでください」の帯が出ます。
SAKAMONO_DATA_SOURCE=fixture

# --- サイトの公開URL（canonical / OGP / sitemap で使用）-----
NEXT_PUBLIC_SITE_URL=https://example.com

# --- 開発版か本番か ------------------------------------------
# 未設定のあいだは「開発版」として扱い、検索エンジンに登録させません
# （全ページ noindex ＋ robots.txt でクロール拒否）。
#
# ★本番公開するときだけ false にしてください。★
#   テストデータ混じりのページが先に検索登録されると、
#   あとから直すのに手間がかかります。
# NEXT_PUBLIC_SITE_PREVIEW=false

# ============================================================
# 以下は第2段階以降で使用予定。現時点では未接続。
# NEXT_PUBLIC_ が付かない変数はサーバー／ビルド時のみで読み込む。
# （NEXT_PUBLIC_ を付けるとブラウザへ露出するので秘密情報には使わない）
# ============================================================

# --- Yahoo!ショッピング 商品検索API（第4段階）---------------
# Yahoo!デベロッパーネットワークで登録した Client ID（アプリケーションID）。
#   https://developer.yahoo.co.jp/webapi/shopping/v3/itemsearch.html
#
# ★このファイルには値を書かないこと。★ .env.local にだけ書きます。
# ★キーをソース・README・テスト・スクリーンショットへ書かないこと。★
#
# 未設定でも build / test は通ります（--sample で動作確認できます）。
YAHOO_CLIENT_ID=

# ============================================================
# 以下は今後使用予定。現時点では未接続。
# ============================================================

# Webgains アフィリエイト（Liverpool 商品フィード / プログラムID 7413）
# 第3段階では未接続。フィードを入手したら external/liverpool/raw.json へ置きます。
# WEBGAINS_PUBLISHER_ID=
# WEBGAINS_API_KEY=

# --- 楽天市場 商品検索API（第5段階）-------------------------
# 楽天ウェブサービスで登録したアプリの認証情報。
#   https://webservice.rakuten.co.jp/documentation/ichiba-item-search
#
# ★2026年のAPI刷新で、2つとも必須になりました。★
#   applicationId だけでは 400 が返ります。
#   accessKey は pk_ で始まる秘密の値です。
#   （旧 app.rakuten.co.jp は 2026年5月14日に停止しました）
#
# ★このファイルには値を書かないこと。★ .env.local にだけ書きます。
# ★キーをソース・README・テスト・スクリーンショットへ書かないこと。★
#
# 未設定でも build / test は通ります（--sample で動作確認できます）。
RAKUTEN_APPLICATION_ID=
RAKUTEN_ACCESS_KEY=

# アフィリエイトID（任意）。
# ★価格の取得には不要です。第5段階ではアフィリエイトリンクを作りません。★
# RAKUTEN_AFFILIATE_ID=

# 為替レート取得API
# FX_API_KEY=
